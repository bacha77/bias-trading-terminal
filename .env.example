# Alpaca Trading API Credentials
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
# Use paper trading URL for simulation, or https://api.alpaca.markets for live
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Optional Server Port
PORT=8000

# Gmail SMTP Alert Notifications (for bacha7@gmail.com)
GMAIL_SENDER_EMAIL=your_sender_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
